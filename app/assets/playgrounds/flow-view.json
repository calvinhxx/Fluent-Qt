  "recipe": {
    "cpp": {
      "imports": "#include <FluentQt/Collections.h>\n#include <FluentQt/Design.h>\n#include <QColor>\n#include <QList>\n#include <QPair>\n#include <QStandardItemModel>\n#include <QItemSelectionModel>\n#include <QAbstractItemView>\n#include <QSize>",
      "setup": "auto* control = new fluent::collections::FlowView(%PARENT%);\ncontrol->setHeaderText(QStringLiteral(\"Collection items\"));\ncontrol->setMinimumItemSize(QSize(144, 92));\nauto* model = new QStandardItemModel(control);\nfor (const QPair<QString, QColor>& entry : QList<QPair<QString, QColor>>{\n         {QStringLiteral(\"Atrium\"), QColor(QStringLiteral(\"#c86b2d\"))},\n         {QStringLiteral(\"Harbor\"), QColor(QStringLiteral(\"#1e6fd9\"))},\n         {QStringLiteral(\"Canyon\"), QColor(QStringLiteral(\"#f7975b\"))},\n         {QStringLiteral(\"Studio\"), QColor(QStringLiteral(\"#6b4fa2\"))},\n         {QStringLiteral(\"Garden\"), QColor(QStringLiteral(\"#2f9e44\"))},\n         {QStringLiteral(\"Dawn\"), QColor(QStringLiteral(\"#3d8ba3\"))}}) {\n    auto* item = new QStandardItem(entry.first);\n    item->setData(entry.second, Qt::DecorationRole);\n    model->appendRow(item);\n}\ncontrol->setModel(model);\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtCore import Qt, QItemSelectionModel, QSize\nfrom PySide6.QtGui import QColor, QStandardItem, QStandardItemModel\nfrom PySide6.QtWidgets import QAbstractItemView",
      "setup": "control = fluentqt.FlowView(%PARENT%)\ncontrol.setHeaderText(\"Collection items\")\ncontrol.setMinimumItemSize(QSize(144, 92))\nmodel = QStandardItemModel(control)\nfor label, tone in [(\"Atrium\", \"#c86b2d\"), (\"Harbor\", \"#1e6fd9\"), (\"Canyon\", \"#f7975b\"), (\"Studio\", \"#6b4fa2\"), (\"Garden\", \"#2f9e44\"), (\"Dawn\", \"#3d8ba3\")]:\n    item = QStandardItem(label)\n    item.setData(QColor(tone), Qt.ItemDataRole.DecorationRole)\n    model.appendRow(item)\ncontrol.setModel(model)\n"
    }
  },
