      "setup": "auto* control = new fluent::charts::DonutChart(%PARENT%);\nauto* model = new fluent::charts::ChartModel(control);\nmodel->setName(QStringLiteral(\"Series A\"));\nmodel->setPoints({{0, 48}, {1, 27}, {2, 16}, {3, 9}}, {QStringLiteral(\"Direct\"), QStringLiteral(\"Search\"), QStringLiteral(\"Referral\"), QStringLiteral(\"Campaign\")});\ncontrol->setModel(model);\ncontrol->setCenterText(QStringLiteral(\"48%\"));\ncontrol->setCenterCaption(QStringLiteral(\"Direct\"));\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtCore import QPointF",
      "setup": "control = fluentqt.DonutChart(%PARENT%)\nmodel = fluentqt.ChartModel(control)\nmodel.setName(\"Series A\")\nmodel.setPoints([QPointF(0, 48), QPointF(1, 27), QPointF(2, 16), QPointF(3, 9)], [\"Direct\", \"Search\", \"Referral\", \"Campaign\"])\ncontrol.setModel(model)\ncontrol.setCenterText(\"48%\")\ncontrol.setCenterCaption(\"Direct\")\n"
    }
