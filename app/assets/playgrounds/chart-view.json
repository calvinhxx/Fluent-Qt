  "recipe": {
    "cpp": {
      "imports": "#include <FluentQt/Charts.h>\n#include <limits>",
      "setup": "auto* control = new fluent::charts::ChartView(%PARENT%);\nauto* model = new fluent::charts::ChartModel(control);\nmodel->setName(QStringLiteral(\"Series A\"));\nmodel->setPoints({{0, 22}, {1, 38}, {2, 31}, {3, 54}, {4, 46}}, {QStringLiteral(\"Mon\"), QStringLiteral(\"Tue\"), QStringLiteral(\"Wed\"), QStringLiteral(\"Thu\"), QStringLiteral(\"Fri\")});\ncontrol->setModel(model);\ncontrol->setTitle(QStringLiteral(\"Weekly traffic\"));\ncontrol->setSubtitle(QStringLiteral(\"Requests per day\"));\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtCore import QPointF",
      "setup": "control = fluentqt.ChartView(%PARENT%)\nmodel = fluentqt.ChartModel(control)\nmodel.setName(\"Series A\")\nmodel.setPoints([QPointF(0, 22), QPointF(1, 38), QPointF(2, 31), QPointF(3, 54), QPointF(4, 46)], [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\"])\ncontrol.setModel(model)\ncontrol.setTitle(\"Weekly traffic\")\ncontrol.setSubtitle(\"Requests per day\")\n"
    }
  },
