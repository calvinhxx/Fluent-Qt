  "recipe": {
    "cpp": {
      "imports": "#include <FluentQt/Collections.h>\n#include <FluentQt/Design.h>\n#include <QStandardItemModel>\n#include <QItemSelectionModel>\n#include <QAbstractItemView>\n#include <QListView>",
      "setup": "auto* control = new fluent::collections::ListView(%PARENT%);\ncontrol->setHeaderText(QStringLiteral(\"Contacts\"));\nauto* model = new QStandardItemModel(control);\nfor (const auto& label : {QStringLiteral(\"Kendall Collins\"), QStringLiteral(\"Henry Ross\"), QStringLiteral(\"Nicole Wagner\"), QStringLiteral(\"Adam Wolfe\"), QStringLiteral(\"Maya Patel\"), QStringLiteral(\"Alex Chen\")})\n    model->appendRow(new QStandardItem(label));\ncontrol->setModel(model);\ncontrol->setCurrentIndex(model->index(0, 0));\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtGui import QStandardItem, QStandardItemModel\nfrom PySide6.QtCore import QItemSelectionModel\nfrom PySide6.QtWidgets import QAbstractItemView, QListView",
      "setup": "control = fluentqt.ListView(%PARENT%)\ncontrol.setHeaderText(\"Contacts\")\nmodel = QStandardItemModel(control)\nfor label in [\"Kendall Collins\", \"Henry Ross\", \"Nicole Wagner\", \"Adam Wolfe\", \"Maya Patel\", \"Alex Chen\"]:\n    model.appendRow(QStandardItem(label))\ncontrol.setModel(model)\ncontrol.setCurrentIndex(model.index(0, 0))\n"
    }
  },
