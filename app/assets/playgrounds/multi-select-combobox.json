  "title": "MultiSelectComboBox",
  "className": "fluent::basicinput::MultiSelectComboBox",
  "recipe": {
    "cpp": {
      "imports": "#include <FluentQt/BasicInput.h>\n#include <QStandardItemModel>",
      "setup": "auto* control = new fluent::basicinput::MultiSelectComboBox(%PARENT%);\nauto* model = new QStandardItemModel(control);\nfor (const auto& text : {QStringLiteral(\"Design\"), QStringLiteral(\"Engineering\"), QStringLiteral(\"Research\"), QStringLiteral(\"Marketing\"), QStringLiteral(\"Security\")}) {\n    auto* item = new QStandardItem(text);\n    item->setData(text, Qt::UserRole);\n    model->appendRow(item);\n}\ncontrol->setModel(model);\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtCore import Qt\nfrom PySide6.QtGui import QStandardItemModel, QStandardItem",
      "setup": "control = fluentqt.MultiSelectComboBox(%PARENT%)\nmodel = QStandardItemModel(control)\nfor text in [\"Design\", \"Engineering\", \"Research\", \"Marketing\", \"Security\"]:\n    item = QStandardItem(text)\n    item.setData(text, Qt.ItemDataRole.UserRole)\n    model.appendRow(item)\ncontrol.setModel(model)\n"
    }
  },
