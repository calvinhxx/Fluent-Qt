  "recipe": {
    "cpp": {
      "imports": "#include <FluentQt/Collections.h>\n#include <QStandardItemModel>\n#include <QItemSelectionModel>\n#include <QAbstractItemView>\n#include <QHeaderView>",
      "setup": "auto* control = new fluent::collections::DataGrid(%PARENT%);\nauto* model = new QStandardItemModel(5, 3, control);\nmodel->setHorizontalHeaderLabels({QStringLiteral(\"Project\"), QStringLiteral(\"Owner\"), QStringLiteral(\"Status\")});\nconst QString rows[5][3] = {\n    {QStringLiteral(\"Fluent workspace\"), QStringLiteral(\"Mina Chen\"), QStringLiteral(\"In progress\")},\n    {QStringLiteral(\"Chart accessibility\"), QStringLiteral(\"Noah Park\"), QStringLiteral(\"Review\")},\n    {QStringLiteral(\"Theme token audit\"), QStringLiteral(\"Sara Ortiz\"), QStringLiteral(\"Planned\")},\n    {QStringLiteral(\"Overlay keyboard flow\"), QStringLiteral(\"Liam Brooks\"), QStringLiteral(\"Done\")},\n    {QStringLiteral(\"Package smoke check\"), QStringLiteral(\"Maya Patel\"), QStringLiteral(\"In progress\")},\n};\nfor (int r = 0; r < 5; ++r) {\n    for (int c = 0; c < 3; ++c)\n        model->setItem(r, c, new QStandardItem(rows[r][c]));\n}\ncontrol->setModel(model);\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtGui import QStandardItem, QStandardItemModel\nfrom PySide6.QtCore import QItemSelectionModel\nfrom PySide6.QtWidgets import QAbstractItemView\nfrom PySide6.QtCore import Qt",
      "setup": "control = fluentqt.DataGrid(%PARENT%)\nmodel = QStandardItemModel(5, 3, control)\nmodel.setHorizontalHeaderLabels([\"Project\", \"Owner\", \"Status\"])\nrows = [\n    (\"Fluent workspace\", \"Mina Chen\", \"In progress\"),\n    (\"Chart accessibility\", \"Noah Park\", \"Review\"),\n    (\"Theme token audit\", \"Sara Ortiz\", \"Planned\"),\n    (\"Overlay keyboard flow\", \"Liam Brooks\", \"Done\"),\n    (\"Package smoke check\", \"Maya Patel\", \"In progress\"),\n]\nfor r, (project, owner, status) in enumerate(rows):\n    model.setItem(r, 0, QStandardItem(project))\n    model.setItem(r, 1, QStandardItem(owner))\n    model.setItem(r, 2, QStandardItem(status))\ncontrol.setModel(model)\n"
    }
  },
