  "recipe": {
    "cpp": {
      "imports": "#include <FluentQt/Collections.h>\n#include <FluentQt/Design.h>\n#include <QStandardItemModel>\n#include <QHeaderView>\n#include <QItemSelectionModel>\n#include <QAbstractItemView>",
      "setup": "auto* control = new fluent::collections::TreeView(%PARENT%);\ncontrol->setHeaderText(QStringLiteral(\"Project files\"));\nauto* model = new QStandardItemModel(control);\nauto* work = new QStandardItem(QStringLiteral(\"Work documents\"));\nwork->appendRow(new QStandardItem(QStringLiteral(\"Proposal.docx\")));\nwork->appendRow(new QStandardItem(QStringLiteral(\"Budget.xlsx\")));\nauto* photos = new QStandardItem(QStringLiteral(\"Photos\"));\nphotos->appendRow(new QStandardItem(QStringLiteral(\"Trip.png\")));\nphotos->appendRow(new QStandardItem(QStringLiteral(\"Family.png\")));\nmodel->appendRow(work);\nmodel->appendRow(photos);\ncontrol->setModel(model);\ncontrol->expandAll();\ncontrol->header()->setStretchLastSection(false);\ncontrol->setColumnWidth(0, 800);\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtGui import QStandardItem, QStandardItemModel\nfrom PySide6.QtCore import QItemSelectionModel\nfrom PySide6.QtWidgets import QAbstractItemView",
      "setup": "control = fluentqt.TreeView(%PARENT%)\ncontrol.setHeaderText(\"Project files\")\nmodel = QStandardItemModel(control)\nwork = QStandardItem(\"Work documents\")\nwork.appendRow(QStandardItem(\"Proposal.docx\"))\nwork.appendRow(QStandardItem(\"Budget.xlsx\"))\nphotos = QStandardItem(\"Photos\")\nphotos.appendRow(QStandardItem(\"Trip.png\"))\nphotos.appendRow(QStandardItem(\"Family.png\"))\nmodel.appendRow(work)\nmodel.appendRow(photos)\ncontrol.setModel(model)\ncontrol.expandAll()\ncontrol.header().setStretchLastSection(False)\ncontrol.setColumnWidth(0, 800)\n"
    }
  },
