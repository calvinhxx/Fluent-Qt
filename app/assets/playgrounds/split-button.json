  "title": "SplitButton",
  "className": "fluent::basicinput::SplitButton",
  "recipe": {
    "cpp": {
      "imports": "#include <FluentQt/BasicInput.h>\n#include <FluentQt/Design.h>\n#include <FluentQt/MenusToolbars.h>\n#include <QAction>\n#include <QPoint>",
      "setup": "auto* control = new fluent::basicinput::SplitButton(QStringLiteral(\"Continue\"), %PARENT%);\nauto* menu = new fluent::menus_toolbars::FluentMenu(QStringLiteral(\"Actions\"), control);\nmenu->addAction(new QAction(QStringLiteral(\"Copy\"), menu));\nmenu->addAction(new QAction(QStringLiteral(\"Share\"), menu));\ncontrol->setMenu(menu);\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom PySide6.QtGui import QAction\nfrom PySide6.QtCore import QPoint",
      "setup": "control = fluentqt.SplitButton(\"Continue\", %PARENT%)\nmenu = fluentqt.FluentMenu(\"Actions\", control)\nmenu.addAction(QAction(\"Copy\", menu))\nmenu.addAction(QAction(\"Share\", menu))\ncontrol.setMenu(menu)\n"
    }
  },
