    "cpp": {
      "imports": "#include <FluentQt/BasicInput.h>\n#include <FluentQt/Layout.h>\n#include <FluentQt/Spatial.h>\n#include <FluentQt/TextFields.h>\n#include <QVBoxLayout>\n#include <QVector3D>",
      "setup": "auto* view = new fluent::spatial::SpatialView(%PARENT%);\nauto* card = new fluent::layout::Card;\ncard->setFixedSize(240, 136);\nauto* control = view->addWidget(card, fluent::WidgetOwnership::Owned);\ncard->setAppearance(fluent::layout::Card::LayerAlt);\nauto* layout = new QVBoxLayout(card);\nlayout->addWidget(new fluent::textfields::Label(QStringLiteral(\"Item transform\"), card));\nlayout->addWidget(new fluent::textfields::Label(QStringLiteral(\"Adjust position, rotation, and scale.\"), card));\nlayout->addWidget(new fluent::basicinput::Button(QStringLiteral(\"Active card\"), card), 0, Qt::AlignLeft);\n"
    },
    "python": {
      "imports": "import fluentqt\nfrom fluentqt.spatial import SpatialView\nfrom PySide6.QtGui import QVector3D\nfrom PySide6.QtWidgets import QVBoxLayout\nfrom PySide6.QtCore import Qt",
      "setup": "view = SpatialView(%PARENT%)\ncard = fluentqt.Card()\ncard.setFixedSize(240, 136)\ncontrol = view.addOwnedWidget(card)\ncard.setAppearance(fluentqt.Card.Appearance.LayerAlt)\nlayout = QVBoxLayout(card)\nlayout.addWidget(fluentqt.Label(\"Item transform\", card))\nlayout.addWidget(fluentqt.Label(\"Adjust position, rotation, and scale.\", card))\nlayout.addWidget(fluentqt.Button(\"Active card\", card), 0, Qt.AlignmentFlag.AlignLeft)\n"
    }
  },
