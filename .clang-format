# FluentQt C++ formatting contract.
#
# The repository adopts this contract incrementally: format and check only
# files changed by the current work. tools/quality/check_cpp_format.py pins the
# formatter to clang-format 22.1.8 so local and CI output stays deterministic.
---
Language: Cpp
BasedOnStyle: LLVM

Standard: c++17
ColumnLimit: 120
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never

# Qt properties are declarations, not ordinary comma-separated macro arguments.
# Keep short properties compact; wrap long ones at complete READ/WRITE/NOTIFY clauses.
AllowBreakBeforeQtProperty: true
BinPackParameters: OnePerLine
BinPackArguments: true
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false

# Continuations follow the block indentation instead of the length of a callee/type.
AlignAfterOpenBracket: false
AlignOperands: DontAlign
BreakBeforeBinaryOperators: NonAssignment
PenaltyIndentedWhitespace: 30
PenaltyBreakBeforeFirstCallParameter: 200
PenaltyReturnTypeOnItsOwnLine: 300
PenaltyBreakAssignment: 100

AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: false
IndentPPDirectives: None

DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

SortIncludes: Never
IncludeBlocks: Preserve
SortUsingDeclarations: false
ReflowComments: false
BreakStringLiterals: false
...
