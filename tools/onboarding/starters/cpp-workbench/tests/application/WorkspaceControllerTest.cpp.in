#include "application/WorkspaceController.h"
#include "application/WorkspaceRepository.h"

#include <cstdlib>
#include <iostream>

namespace {

void require(bool condition, const char* expression, int line)
{
    if (!condition) {
        std::cerr << "Check failed at line " << line << ": " << expression << '\n';
        std::exit(1);
    }
}

#define CHECK(expr) require(static_cast<bool>(expr), #expr, __LINE__)

class Repository final : public @APP_NAMESPACE@::application::WorkspaceRepository {
public:
    @APP_NAMESPACE@::domain::Workspace currentWorkspace() const override
    {
        ++m_calls;
        if (m_calls == 1)
            return {};
        return { "FluentQt", "/work/FluentQt" };
    }

private:
    mutable int m_calls = 0;
};

} // namespace

int main()
{
    Repository repository;
    @APP_NAMESPACE@::application::WorkspaceController controller(repository);
    CHECK(!controller.state().hasWorkspace);
    CHECK(controller.state().title == "No workspace");
    CHECK(controller.state().status == "Unavailable");
    controller.refresh();
    CHECK(controller.state().hasWorkspace);
    CHECK(controller.state().title == "FluentQt");
    CHECK(!controller.state().darkTheme);
    controller.toggleTheme();
    CHECK(controller.state().darkTheme);
    return 0;
}
