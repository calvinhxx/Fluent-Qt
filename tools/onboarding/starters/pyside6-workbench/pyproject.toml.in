[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "@APP_ID@"
version = "0.1.0"
description = "Native FluentQt workbench for @APP_NAME@"
requires-python = ">=3.11,<3.14"
dependencies = [
  "FluentQt>=1.7.1,<2",
  "PySide6>=6.2,<7"
]

[project.scripts]
@APP_ID@ = "@APP_MODULE@.app.main:main"

[tool.setuptools.packages.find]
where = ["src"]
