#pragma once

#include <QAbstractTableModel>

#include <vector>

#include "domain/Telemetry.h"

namespace @APP_NAMESPACE@::ui {

class TelemetryTableModel final : public QAbstractTableModel {
public:
    explicit TelemetryTableModel(QObject* parent = nullptr);

    void setEvents(std::vector<domain::TelemetryEvent> events);

    int rowCount(const QModelIndex& parent = QModelIndex()) const override;
    int columnCount(const QModelIndex& parent = QModelIndex()) const override;
    QVariant data(const QModelIndex& index,
                  int role = Qt::DisplayRole) const override;
    QVariant headerData(int section, Qt::Orientation orientation,
                        int role = Qt::DisplayRole) const override;

private:
    std::vector<domain::TelemetryEvent> m_events;
};

} // namespace @APP_NAMESPACE@::ui
