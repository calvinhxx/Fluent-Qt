#!/usr/bin/env python3

"""Portable FluentQt onboarding command."""

from __future__ import annotations

import sys

import fluentqt_create
import fluentqt_doctor
import fluentqt_trial


def _usage() -> str:
    return "Usage: fluentqt <doctor|create|trial> [options]"


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments or arguments[0] in {"-h", "--help"}:
        print(_usage())
        print("  doctor  Check a C++ or Python consumer environment")
        print("  create  Generate a maintained FluentQt starter")
        print("  trial   Measure the path to a working starter window")
        return 0
    command, remaining = arguments[0], arguments[1:]
    if command == "doctor":
        return fluentqt_doctor.main(remaining)
    if command == "create":
        return fluentqt_create.main(remaining)
    if command == "trial":
        return fluentqt_trial.main(remaining)
    print(f"Unknown command: {command}", file=sys.stderr)
    print(_usage(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
