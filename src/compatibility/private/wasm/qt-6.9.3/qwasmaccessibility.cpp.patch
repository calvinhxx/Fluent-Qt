+    case QAccessible::LocationChanged: {
+        // A parent move changes descendant screen rectangles without moving
+        // those widgets locally. Coalesce layout notifications and update only
+        // already published interfaces; never create model-cell interfaces.
+        static bool pending = false;
+        if (!pending) {
+            pending = true;
+            QTimer::singleShot(0, QCoreApplication::instance(), [] {
+                pending = false;
