  ],
  "risk_families": [
    {
      "id": "transient-overlay",
      "severity": "high",
      "owner": "fluentqt-maintainers:transient-surfaces",
      "rationale": "Transient surfaces combine placement, focus, dismissal, stacking, and animation state that is easy to regress without changing an API.",
      "components": [
        "auto-suggest-box",
        "calendar-date-picker",
        "coach-mark",
        "color-picker",
        "combobox",
        "content-dialog",
        "date-picker",
        "dialog",
        "drawer-view",
        "dropdown-button",
        "flyout",
        "multi-select-combobox",
        "popup",
        "split-button",
        "teaching-tip",
        "time-picker",
        "toast",
        "toggle-split-button",
        "tooltip"
      ],
      "required_states": [
        "normal-light",
        "normal-dark",
        "open",
        "placement",
        "keyboard-focus",
        "dismissed",
        "narrow",
        "native-animation"
      ],
      "manual_contract": {
        "status": "human-required",
        "platforms": [
          "macos",
          "windows",
          "linux"
        ],
        "procedure": "docs/development/visual-review.md",
        "reason": "Native popup stacking, focus transfer, light-dismiss behavior, and animation polish require a real desktop review."
      }
    },
    {
      "id": "calendar-layout",
      "severity": "high",
      "owner": "fluentqt-maintainers:date-time",
      "rationale": "Calendar geometry changes across month data, selection, locale, direction, and responsive width.",
      "components": [
        "calendar-view"
      ],
      "required_states": [
        "normal-light",
        "normal-dark",
        "selection",
        "keyboard-focus",
        "narrow",
        "rtl",
        "native-animation"
      ],
      "manual_contract": {
        "status": "human-required",
        "platforms": [
          "macos",
          "windows",
          "linux"
        ],
        "procedure": "docs/development/visual-review.md",
        "reason": "Locale typography, focus visibility, and native animation timing remain human-reviewed desktop behavior."
      }
    },
    {
      "id": "command-layering",
      "severity": "high",
      "owner": "fluentqt-maintainers:command-surfaces",
      "rationale": "Commands redistribute into overflow layers whose order, clipping, focus, and popup z-order must remain stable.",
      "components": [
        "command-bar",
        "command-bar-flyout",
        "menu",
        "menu-bar"
      ],
      "required_states": [
        "normal-light",
        "normal-dark",
        "open-layering",
        "keyboard-focus",
        "narrow",
        "rtl",
        "native-popup"
      ],
      "manual_contract": {
        "status": "human-required",
        "platforms": [
          "macos",
          "windows",
          "linux"
        ],
        "procedure": "docs/development/visual-review.md",
        "reason": "Native menu activation, popup stacking, access keys, and animation cannot be certified by injected Qt events alone."
      }
    },
    {
      "id": "collection-scroll",
      "severity": "high",
      "owner": "fluentqt-maintainers:collections-and-scrolling",
      "rationale": "Model/view controls combine viewport geometry, selection, scrolling, delegates, and direction-sensitive hit testing.",
      "components": [
        "annotated-scrollbar",
        "data-grid",
        "flip-view",
        "flow-view",
        "grid-view",
        "list-view",
        "pips-pager",
        "scroll-view",
        "scrollbar",
        "stack-view",
        "tree-view"
      ],
      "required_states": [
        "normal-light",
        "normal-dark",
        "selection",
        "scroll-end",
        "narrow",
        "rtl",
        "native-input"
      ],
      "manual_contract": {
        "status": "human-required",
        "platforms": [
          "macos",
          "windows",
          "linux"
        ],
        "procedure": "docs/development/visual-review.md",
        "reason": "Physical wheel, trackpad, touch, and drag behavior plus raster polish require human review on native desktops."
      }
    },
    {
      "id": "responsive-navigation",
      "severity": "high",
      "owner": "fluentqt-maintainers:navigation",
      "rationale": "Navigation controls change structure and overflow behavior at responsive thresholds and under RTL layout.",
      "components": [
        "breadcrumb",
        "navigation-view",
        "pivot",
        "selector-bar",
        "tab-view"
      ],
      "required_states": [
        "normal-light",
        "normal-dark",
        "selection",
        "keyboard-focus",
        "narrow",
        "rtl"
      ],
      "manual_contract": {
