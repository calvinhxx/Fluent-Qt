        "platforms": [
          "macos",
          "windows",
          "linux"
        ],
        "procedure": "docs/development/visual-review.md",
        "reason": "Focus traversal, transition polish, and platform input behavior remain explicit human-review evidence."
      }
    },
    {
      "id": "window-material",
      "severity": "high",
      "owner": "fluentqt-maintainers:windowing",
      "rationale": "Window chrome and materials depend on OS composition, activation, resizing, display configuration, and theme state.",
      "components": [
        "title-bar",
        "window"
      ],
      "required_states": [
        "normal-light",
        "normal-dark",
        "narrow",
        "native-window-management"
      ],
      "manual_contract": {
        "status": "human-required",
        "platforms": [
          "macos",
          "windows",
          "linux"
        ],
        "procedure": "docs/development/visual-review.md",
        "reason": "Mica or Acrylic composition, native title-bar behavior, multi-display movement, and activation must be reviewed on each target OS."
      }
    }
  ],
