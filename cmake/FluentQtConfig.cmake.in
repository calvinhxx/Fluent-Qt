@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Widgets)

if(APPLE)
    include("${CMAKE_CURRENT_LIST_DIR}/FluentQtApplePlatformDependencies.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FluentQtTargets.cmake")

# Loading the base package must not discover Qt OpenGL modules, even when Spatial is installed.
foreach(_fluent_component IN LISTS FluentQt_FIND_COMPONENTS)
    set(FluentQt_${_fluent_component}_FOUND FALSE)
    if(_fluent_component STREQUAL "Spatial" AND @FLUENT_QT_BUILD_SPATIAL@)
        if(@QT_VERSION_MAJOR@ EQUAL 6)
            find_package(Qt6 QUIET COMPONENTS OpenGLWidgets)
        endif()
        if(@QT_VERSION_MAJOR@ EQUAL 5 OR TARGET Qt6::OpenGLWidgets)
            include("${CMAKE_CURRENT_LIST_DIR}/FluentQtSpatialTargets.cmake")
            set(FluentQt_Spatial_FOUND TRUE)
        endif()
    endif()
    if(NOT FluentQt_${_fluent_component}_FOUND AND FluentQt_FIND_REQUIRED_${_fluent_component})
        set(FluentQt_NOT_FOUND_MESSAGE "Requested FluentQt component ${_fluent_component} is not installed or its Qt OpenGL dependency is unavailable.")
    endif()
endforeach()
check_required_components(FluentQt)
