# Build the Widgets lookup table with the existing CMake toolchain, including in
# cross builds. The public JSON resources remain available to catalog browsers.
file(READ "${catalog}" source)
string(REGEX REPLACE "[ \t\r\n]" "" source "${source}")
string(REGEX MATCHALL "\"[^\"]+\":[0-9]+" entries "${source}")
set(rows)
foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^\"ic_fluent_([a-z0-9_]+)_([0-9]+)_regular\":([0-9]+)$")
        message(FATAL_ERROR "Unexpected icon record: ${entry}")
    endif()
    list(APPEND rows "${CMAKE_MATCH_1}!${CMAKE_MATCH_2}!${CMAKE_MATCH_3}")
endforeach()
list(SORT rows)
set(families "")
set(variants "")
set(offset 0)
set(group -1)
set(codes)
foreach(row IN LISTS rows)
    string(REPLACE "!" ";" parts "${row}")
    list(GET parts 0 family)
    list(GET parts 1 size)
    list(GET parts 2 code)
    if(NOT family STREQUAL previous)
        if(DEFINED previous)
            string(APPEND families "{\"${previous}\", ${start}, ${count}},\n")
        endif()
        set(previous "${family}")
        set(start ${offset})
        set(count 0)
        math(EXPR group "${group}+1")
    endif()
    string(APPEND variants "{${code}, ${size}},\n")
    set(named_ic_fluent_${family}_${size}_regular ${group})
    set(family_${code} ${group})
    math(EXPR order "${code}+1114112") # fixed-width decimal key, including supplementary planes
    list(APPEND codes "${order}!${code}")
    math(EXPR count "${count}+1")
    math(EXPR offset "${offset}+1")
endforeach()
if(NOT rows)
    message(FATAL_ERROR "Empty icon catalog")
endif()
string(APPEND families "{\"${previous}\", ${start}, ${count}},\n")
file(READ "${aliases}" source)
string(REGEX REPLACE "[ \t\r\n]" "" source "${source}")
string(REGEX MATCHALL "\"[0-9a-fA-F]+\":\"[^\"]+\"" entries "${source}")
foreach(entry IN LISTS entries)
    string(REGEX MATCH "^\"([0-9a-fA-F]+)\":\"([^\"]+)\"$" matched "${entry}")
    math(EXPR code "0x${CMAKE_MATCH_1}")
    set(target "named_${CMAKE_MATCH_2}")
    if(NOT DEFINED ${target})
        message(FATAL_ERROR "Unknown icon alias: ${entry}")
    endif()
    set(family_${code} ${${target}})
    math(EXPR order "${code}+1114112")
    list(APPEND codes "${order}!${code}")
endforeach()
list(REMOVE_DUPLICATES codes)
list(SORT codes)
set(reverse "")
foreach(row IN LISTS codes)
    string(REGEX REPLACE "^[0-9]+!" "" code "${row}")
    string(APPEND reverse "{${code}, ${family_${code}}},\n")
endforeach()
file(WRITE "${output}"
    "constexpr Family families[] = {\n${families}};\n"
    "constexpr Variant variants[] = {\n${variants}};\n"
    "constexpr CodeFamily codeFamilies[] = {\n${reverse}};\n")
