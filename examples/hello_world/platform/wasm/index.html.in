<!doctype html>
<html lang="en" data-fluent-qt-loaded="false">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title>FluentQt UILib Hello World</title>
  <style>
    :root { color-scheme: light dark; font-family: Inter, system-ui, sans-serif; }
    * { box-sizing: border-box; }
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    body { display: grid; grid-template-rows: minmax(0, 1fr) auto; background: #e9edf3; }
    #qt-container {
      position: relative;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      background:
        radial-gradient(circle at 18% 8%, rgb(0 103 192 / 10%), transparent 34%),
        radial-gradient(circle at 82% 92%, rgb(124 77 255 / 9%), transparent 38%),
        #eef1f5;
    }
    #loading {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: grid;
      place-content: center;
      gap: 12px;
      text-align: center;
      background: #f7f8fa;
      transition: opacity 160ms ease;
    }
    #loading.hidden { opacity: 0; pointer-events: none; }
    #loading.error { color: #b42318; }
    .spinner {
      width: 26px;
      height: 26px;
      margin: auto;
      border: 3px solid #c7c7c7;
      border-top-color: #0067c0;
      border-radius: 50%;
      animation: spin .8s linear infinite;
    }
    #loading.error .spinner { display: none; }
    footer {
      min-height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 6px 12px;
      font-size: 12px;
      color: #5d5d5d;
      background: #fafafa;
      border-top: 1px solid #dedede;
    }
    footer a { color: #005fb8; }
    @media (prefers-color-scheme: dark) {
      body { background: #20242a; }
      #loading { background: #202020; color: #f5f5f5; }
      #qt-container {
        background:
          radial-gradient(circle at 18% 8%, rgb(96 205 255 / 10%), transparent 34%),
          radial-gradient(circle at 82% 92%, rgb(139 92 246 / 10%), transparent 38%),
          #20242a;
      }
      footer { color: #c7c7c7; background: #181818; border-color: #3b3b3b; }
      footer a { color: #60cdff; }
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <main id="qt-container" aria-label="Minimal FluentQt UILib WebAssembly app">
    <section id="loading" role="status" aria-live="polite">
      <div class="spinner" aria-hidden="true"></div>
      <strong>Loading FluentQt UILib…</strong>
      <span id="loading-detail">Minimal installed-consumer example</span>
    </section>
  </main>
  <footer>
    <span>Independent <code>FluentQt::FluentQt</code> consumer</span>
    <a href="../">Back to Gallery</a>
  </footer>
  <script src="qtloader.js"></script>
  <script src="fluentqt_hello_world.js"></script>
  <script>
    const container = document.getElementById('qt-container');
    const loading = document.getElementById('loading');
    const detail = document.getElementById('loading-detail');
    (async () => {
      try {
        await qtLoad({
          qt: {
            entryFunction: window.fluentqt_hello_world_entry,
            containerElements: [container],
            onLoaded: () => {
              document.documentElement.dataset.fluentQtLoaded = 'true';
              loading.classList.add('hidden');
              window.setTimeout(() => loading.remove(), 180);
            },
            onExit: exit => {
              document.documentElement.dataset.fluentQtExit = String(exit?.code ?? 'unknown');
            }
          }
        });
      } catch (error) {
        console.error(error);
        document.documentElement.dataset.fluentQtError = String(error);
        loading.classList.add('error');
        detail.textContent = `Could not start WebAssembly: ${error}`;
      }
    })();
  </script>
</body>
</html>
